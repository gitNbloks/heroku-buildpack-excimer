#!/bin/bash
set -e

BUILD_DIR=$1

echo "-----> Installing excimer PHP extension"

PHP_DIR="$BUILD_DIR/.heroku/php"
PHP_BIN="$PHP_DIR/bin/php"
PHPIZE="$PHP_DIR/bin/phpize"
PHP_CONFIG="$PHP_DIR/bin/php-config"

if [ ! -f "$PHP_BIN" ]; then
  echo "       ERROR: heroku/php must be listed before this buildpack"
  exit 1
fi

export PATH="$PHP_DIR/bin:$PATH"

# Download and build excimer from source
EXCIMER_VERSION="1.2.1"
WORKDIR=$(mktemp -d)
curl -sSL "https://pecl.php.net/get/excimer-${EXCIMER_VERSION}.tgz" | tar -xz -C "$WORKDIR"
cd "$WORKDIR/excimer-${EXCIMER_VERSION}"

$PHPIZE
./configure --with-php-config="$PHP_CONFIG"
make -j$(nproc)

EXT_DIR=$("$PHP_BIN" -r "echo ini_get('extension_dir');")
cp modules/excimer.so "$EXT_DIR/excimer.so"

CONF_DIR="$PHP_DIR/etc/php/conf.d"
mkdir -p "$CONF_DIR"
echo "extension=excimer" > "$CONF_DIR/excimer.ini"

echo "       excimer ${EXCIMER_VERSION} installed"
